# Copy to .env. Nothing here is a real secret; generate your own values for anything marked CHANGE.
FORMWORK_ENV=dev
FORMWORK_LOG_JSON=false

# Postgres. The app role must NOT own the tables (row-level security applies to non-owners only).
FORMWORK_DATABASE_URL=postgresql+psycopg://formwork_app:formwork_app@localhost:5432/formwork
FORMWORK_DATABASE_ADMIN_URL=postgresql+psycopg://formwork:formwork@localhost:5432/formwork
FORMWORK_REDIS_URL=redis://localhost:6379/0
FORMWORK_QUEUE=arq                      # arq | inline (inline runs jobs in the API process; dev only)

# Object store
FORMWORK_OBJECT_STORE=s3                # s3 | local
FORMWORK_S3_ENDPOINT_URL=http://localhost:9000
FORMWORK_S3_BUCKET=formwork
FORMWORK_S3_ACCESS_KEY=minioadmin       # CHANGE outside local dev
FORMWORK_S3_SECRET_KEY=minioadmin       # CHANGE outside local dev

# Models. Leave the key empty to run on the offline FakeProvider.
ANTHROPIC_API_KEY=
FORMWORK_MODEL_PROVIDER=auto            # auto | anthropic | fake
FORMWORK_MODEL_CHEAP=claude-haiku-5-5
FORMWORK_MODEL_STRONG=claude-sonnet-5-5
# USD per million tokens; set these to your contract prices.
FORMWORK_PRICE_CHEAP_IN=1.0
FORMWORK_PRICE_CHEAP_OUT=5.0
FORMWORK_PRICE_STRONG_IN=3.0
FORMWORK_PRICE_STRONG_OUT=15.0

# Security
FORMWORK_API_KEY_PEPPER=                # CHANGE: openssl rand -hex 32 (required when FORMWORK_ENV=prod)
FORMWORK_WEBHOOK_ALLOW_PRIVATE_HOSTS=false
FORMWORK_CORS_ORIGINS=["http://localhost:3000"]

# Limits
FORMWORK_MAX_UPLOAD_BYTES=52428800
FORMWORK_MAX_FILES_PER_JOB=50
FORMWORK_DEFAULT_BUDGET_USD=5.0
FORMWORK_AUTO_APPROVE_THRESHOLD=0.9

# Observability (optional). Langfuse accepts OTLP: point this at its /api/public/otel endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web console (apps/web): the key stays server-side in the Next.js proxy.
FORMWORK_API_URL=http://localhost:8000
FORMWORK_API_KEY=
